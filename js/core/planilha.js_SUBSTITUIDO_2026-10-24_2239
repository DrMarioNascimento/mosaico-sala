/* MOSAICO · Formato de planilha da atividade (modo aberto e troca de arquivos)
   Módulo puro: converte atividade ⇄ abas (listas de linhas). A leitura/escrita
   do arquivo .xlsx fica em js/planilha-xlsx.js (navegador).

   Abas:
     Atividade  campo | valor               (dados gerais, meta, guia, pendências)
     Grupos     ordem | id | nome | funcao
     Etapas     ordem | id | titulo | tipo | organizacao | envio | competicao | tempo_min |
                instrucao | pergunta | enunciado | justificativa | min_evidencias |
                aceita_parcial | recebe_de | explicacao
     Opcoes     etapa | id | texto | correta      (hipóteses e alternativas; "x" marca a correta)
     Perguntas  etapa | pergunta | enunciado | a | b | c | d | e | correta | explicacao
                (cadeado do grupo e quiz entre grupos; correta = letra)
     Cartoes    etapa | id | texto | ordem_certa | coluna_certa | posicao_certa
                (cartões de arrastar: ordem_certa = 1, 2, 3…; coluna_certa = id da coluna;
                 posicao_certa = 0 a 100 no termômetro, vazio = só debate)
     Colunas    etapa | id | titulo     (colunas do formato classificar)
     Pecas      id | etapa | grupos | natureza | fonte | conteudo   (grupos separados por ;)
     Fontes     id | descricao | localizacao | trecho
   A resposta correta e a explicação são material de quem conduz: quem for
   distribuir a planilha a outras pessoas deve saber que ela contém o gabarito. */

import { TIPOS } from './tipos.js';
import { SCHEMA_VERSION } from './validacao.js';
import { LETRAS, fragmentosDoTexto } from './desafios.js';

export const ABAS = {
  Atividade: ['campo', 'valor'],
  Grupos: ['ordem', 'id', 'nome', 'funcao'],
  Etapas: ['ordem', 'id', 'titulo', 'tipo', 'organizacao', 'envio', 'competicao', 'tempo_min', 'instrucao', 'pergunta', 'enunciado', 'justificativa', 'min_evidencias', 'aceita_parcial', 'recebe_de', 'explicacao', 'montagem_modo', 'montagem_texto', 'montagem_corte', 'montagem_pecas', 'montagem_colunas', 'montagem_quantidade', 'montagem_ocultar', 'montagem_revelar',
    'cadeado_regra', 'cadeado_distribuicao', 'cadeado_min_acertos', 'cadeado_fragmentos', 'cadeado_codigo', 'cadeado_espera', 'cadeado_mensagem',
    'quiz_ao_errar', 'quiz_segundos', 'quiz_pergunta_no_telao', 'quiz_mostrar_resposta',
    'cartoes_formato', 'cartoes_polo_esquerda', 'cartoes_polo_direita', 'cartoes_margem', 'cartoes_distribuicao', 'cartoes_tentativas', 'cartoes_espera', 'cartoes_conferencia', 'cartoes_revelar'],
  Opcoes: ['etapa', 'id', 'texto', 'correta'],
  Perguntas: ['etapa', 'pergunta', 'enunciado', 'a', 'b', 'c', 'd', 'e', 'correta', 'explicacao'],
  Cartoes: ['etapa', 'id', 'texto', 'ordem_certa', 'coluna_certa', 'posicao_certa'],
  Colunas: ['etapa', 'id', 'titulo'],
  Pecas: ['id', 'etapa', 'grupos', 'natureza', 'fonte', 'conteudo'],
  Fontes: ['id', 'descricao', 'localizacao', 'trecho']
};
/** Aba oculta com as imagens da montagem, em texto (cada célula até 30.000 caracteres). */
export const ABA_IMAGENS = ['etapa', 'parte', 'largura', 'altura', 'dados'];
const PEDACO = 30000;

const LISTAS = ['objetivos', 'pendencias', 'guia', 'pontos_de_discussao', 'meta_etapas'];

/** Normaliza nomes de coluna/aba: minúsculas, sem acentos, espaços viram _. */
export const norm = s => String(s ?? '').normalize('NFD').replace(/[̀-ͯ]/g, '').trim().toLowerCase().replace(/[\s-]+/g, '_');
const txt = v => (v === undefined || v === null) ? '' : String(v).trim();
const sim = v => /^(x|sim|s|true|verdadeiro|1|yes)$/i.test(txt(v));
const num = v => { const t = txt(v).replace(',', '.').replace('%', ''); if (!t) return undefined; const n = Number(t); return Number.isFinite(n) ? n : undefined; };
const linhas = v => txt(v).split(/\r?\n/).map(x => x.trim()).filter(Boolean);

// ---------------------------------------------------------------- atividade → abas
export function atividadeParaAbas(a) {
  const r = a.docente?.respostas || {};
  const meta = a.meta || {};
  const geral = [
    ['id', a.id], ['titulo', a.titulo], ['publico', a.publico], ['duracao_min', a.duracaoMin], ['regime', a.regime],
    ['pergunta_central', a.perguntaCentral], ['introducao', a.introducao],
    ['objetivos', (a.objetivos || []).join('\n')],
    ['meta_ativa', meta.ativa === false || !a.meta ? 'não' : 'sim'], ['meta_limiar', meta.limiar !== undefined ? Math.round(meta.limiar * 100) + '%' : ''],
    ['meta_descricao', meta.descricao], ['meta_etapas', (meta.etapas || []).join('\n')],
    ['guia', (a.docente?.guia || []).join('\n')], ['pontos_de_discussao', (a.docente?.pontosDeDiscussao || []).join('\n')],
    ['pendencias', (a.pendencias || []).join('\n')]
  ].map(([campo, valor]) => ({ campo, valor: valor ?? '' }));

  const grupos = [...a.grupos].sort((x, y) => x.ordemAlocacao - y.ordemAlocacao)
    .map(g => ({ ordem: g.ordemAlocacao, id: g.id, nome: g.nome, funcao: g.funcao || '' }));

  const etapas = [...a.etapas].sort((x, y) => x.ordem - y.ordem).map(e => {
    const c = e.config || {};
    const conexao = a.conexoes.find(x => x.para.etapaId === e.id);
    return {
      ordem: e.ordem, id: e.id, titulo: e.titulo, tipo: e.typeId,
      organizacao: e.participacao?.organizacao, envio: e.participacao?.envio, competicao: e.participacao?.competicao,
      tempo_min: e.tempoMin ?? '', instrucao: e.instrucao || '', pergunta: c.pergunta || '', enunciado: c.enunciado || '',
      justificativa: c.justificativa || '', min_evidencias: c.minEvidencias ?? '', aceita_parcial: c.aceitaParcial ? 'sim' : '',
      recebe_de: conexao ? conexao.de.etapaId : '', explicacao: r[e.id]?.explicacao || '',
      ...(e.typeId === 'montagem_pecas' ? {
        montagem_modo: c.modo || '', montagem_texto: c.texto || '', montagem_corte: c.corte?.tipo || '', montagem_pecas: c.corte?.n ?? '',
        montagem_colunas: c.corte?.colunas ?? '', montagem_quantidade: c.quantidade || 'fixa',
        montagem_ocultar: c.ocultarAoFim === false ? 'não' : 'sim', montagem_revelar: c.revelarAoEncerrar ? 'sim' : 'não'
      } : {}),
      ...(e.typeId === 'cadeado_grupo' ? {
        cadeado_regra: c.regra || '', cadeado_distribuicao: c.distribuicao || 'diferente', cadeado_min_acertos: c.regra === 'acertos' ? (c.minAcertos || 'todos') : '',
        cadeado_fragmentos: (c.fragmentos || []).join(' | '), cadeado_codigo: r[e.id]?.codigo ?? '', cadeado_espera: c.espera ?? 30, cadeado_mensagem: c.mensagem || ''
      } : {}),
      ...(e.typeId === 'cartoes_arrastar' ? {
        cartoes_formato: c.formato || '', cartoes_polo_esquerda: c.polos?.esquerda || '', cartoes_polo_direita: c.polos?.direita || '',
        cartoes_margem: c.formato === 'termometro' ? (r[e.id]?.margem ?? 15) : '', cartoes_distribuicao: c.distribuicao || 'todos',
        cartoes_tentativas: c.tentativas || 'uma', cartoes_espera: c.espera ?? 30, cartoes_conferencia: c.formato === 'ordenar' ? (c.conferencia || 'posicao') : '',
        cartoes_revelar: c.revelarAoEncerrar === false ? 'não' : 'sim'
      } : {}),
      ...(e.typeId === 'quiz_grupos' ? {
        quiz_ao_errar: c.aoErrar || 'repassar', quiz_segundos: c.segundos ?? 60,
        quiz_pergunta_no_telao: c.mostrarNoTelao ? 'sim' : 'não', quiz_mostrar_resposta: c.mostrarResposta === false ? 'não' : 'sim'
      } : {})
    };
  });

  const opcoes = [];
  for (const e of [...a.etapas].sort((x, y) => x.ordem - y.ordem)) {
    const lista = e.config?.hipotesesCandidatas || e.config?.alternativas || [];
    for (const o of lista) opcoes.push({ etapa: e.id, id: o.id, texto: o.texto, correta: r[e.id]?.corretaId === o.id ? 'x' : '' });
  }

  const perguntas = [];
  for (const e of [...a.etapas].sort((x, y) => x.ordem - y.ordem)) {
    for (const q of e.config?.perguntas || []) {
      const rq = r[e.id]?.perguntas?.[q.id] || {};
      const linha = { etapa: e.id, pergunta: q.id, enunciado: q.enunciado, correta: '', explicacao: rq.explicacao || '' };
      // as alternativas vão para as colunas a..e; ids diferentes de a..e são renomeados na ordem
      (q.alternativas || []).slice(0, 5).forEach((o, i) => { linha[LETRAS[i]] = o.texto; if (o.id === rq.corretaId) linha.correta = LETRAS[i]; });
      perguntas.push(linha);
    }
  }

  const cartoes = [], colunas = [];
  for (const e of [...a.etapas].sort((x, y) => x.ordem - y.ordem)) {
    if (e.typeId !== 'cartoes_arrastar') continue;
    const rc = r[e.id] || {}, c = e.config || {};
    for (const col of c.colunas || []) if (c.formato === 'classificar') colunas.push({ etapa: e.id, id: col.id, titulo: col.titulo });
    for (const x of c.cartoes || []) {
      const k = (rc.ordem || []).indexOf(x.id);
      cartoes.push({ etapa: e.id, id: x.id, texto: x.texto,
        ordem_certa: c.formato === 'ordenar' && k >= 0 ? k + 1 : '',
        coluna_certa: c.formato === 'classificar' ? (rc.colunaDe?.[x.id] || '') : '',
        posicao_certa: c.formato === 'termometro' && rc.posicao?.[x.id] !== undefined && rc.posicao[x.id] !== null ? rc.posicao[x.id] : '' });
    }
  }

  const pecas = a.pecas.map(p => ({ id: p.id, etapa: p.etapaId, grupos: p.destinatarios.join('; '), natureza: p.origem?.natureza || '', fonte: p.origem?.fonteId || '', conteudo: p.conteudo }));
  const fontes = a.fontes.map(f => ({ id: f.id, descricao: f.descricao || '', localizacao: f.localizacao || '', trecho: f.trecho || '' }));
  const imagens = [];
  for (const e of a.etapas) {
    const img = e.typeId === 'montagem_pecas' && e.config?.imagem;
    if (!img?.dados) continue;
    for (let i = 0, parte = 1; i < img.dados.length; i += PEDACO, parte++) imagens.push({ etapa: e.id, parte, largura: img.largura || '', altura: img.altura || '', dados: img.dados.slice(i, i + PEDACO) });
  }
  return { Atividade: geral, Grupos: grupos, Etapas: etapas, Opcoes: opcoes, Perguntas: perguntas, Cartoes: cartoes, Colunas: colunas, Pecas: pecas, Fontes: fontes, Imagens: imagens };
}

// ---------------------------------------------------------------- abas → atividade
/**
 * @param abas {nomeDaAba: [ {coluna: valor} ]} — nomes de aba/coluna em qualquer caixa e com ou sem acento.
 * Devolve {atividade, problemas[]}. Problemas de leitura (aba faltando, tipo desconhecido) não
 * substituem a validação completa, que roda depois em validarAtividade().
 */
export function abasParaAtividade(abas) {
  const problemas = [];
  const tab = {};
  for (const [nome, linhasAba] of Object.entries(abas || {})) {
    tab[norm(nome)] = (linhasAba || []).map(l => Object.fromEntries(Object.entries(l).map(([k, v]) => [norm(k), v])))
      .filter(l => Object.values(l).some(v => txt(v) !== ''));
  }
  for (const n of ['atividade', 'grupos', 'etapas']) if (!tab[n]) problemas.push(`Aba "${n[0].toUpperCase() + n.slice(1)}" não encontrada.`);

  const g = {};
  for (const l of tab.atividade || []) g[norm(l.campo)] = LISTAS.includes(norm(l.campo)) ? linhas(l.valor) : txt(l.valor);

  const etapasL = (tab.etapas || []).map(l => ({ ...l, ordem: num(l.ordem) }));
  const opcoesL = tab.opcoes || [];
  const respostas = {};
  const etapas = etapasL.map((l, i) => {
    const typeId = txt(l.tipo);
    const tipo = TIPOS[typeId];
    if (!tipo) problemas.push(`Etapa "${txt(l.titulo) || txt(l.id)}": tipo "${typeId}" desconhecido.`);
    const id = txt(l.id);
    const ops = opcoesL.filter(o => txt(o.etapa) === id).map(o => ({ id: txt(o.id), texto: txt(o.texto), correta: sim(o.correta) }));
    const config = {};
    if (typeId === 'investigacao_fragmentos' || typeId === 'comparar_hipoteses') {
      config.pergunta = txt(l.pergunta);
      config.hipotesesCandidatas = ops.map(({ id, texto }) => ({ id, texto }));
      if (txt(l.justificativa)) config.justificativa = txt(l.justificativa);
      if (typeId === 'investigacao_fragmentos' && num(l.min_evidencias) !== undefined) config.minEvidencias = num(l.min_evidencias);
      if (typeId === 'comparar_hipoteses') config.aceitaParcial = sim(l.aceita_parcial);
    } else if (typeId === 'montagem_pecas') {
      config.modo = txt(l.montagem_modo) || 'texto';
      if (config.modo === 'texto') config.texto = txt(l.montagem_texto);
      else {
        const partes = (tab.imagens || []).filter(x => txt(x.etapa) === id).sort((x, y) => num(x.parte) - num(y.parte));
        if (partes.length) config.imagem = { dados: partes.map(x => txt(x.dados)).join(''), largura: num(partes[0].largura), altura: num(partes[0].altura) };
        config.corte = { tipo: txt(l.montagem_corte) || 'colunas', n: num(l.montagem_pecas) ?? 4, ...(num(l.montagem_colunas) ? { colunas: num(l.montagem_colunas) } : {}) };
      }
      config.quantidade = txt(l.montagem_quantidade) || 'fixa';
      config.ocultarAoFim = !/^(nao|não|n|false|0)$/i.test(txt(l.montagem_ocultar) || 'sim');
      config.revelarAoEncerrar = sim(l.montagem_revelar);
    } else if (typeId === 'cadeado_grupo' || typeId === 'quiz_grupos') {
      const resp = { perguntas: {} };
      config.perguntas = (tab.perguntas || []).filter(q => txt(q.etapa) === id).map((q, k) => {
        const pid = txt(q.pergunta) || 'p' + (k + 1);
        const alternativas = LETRAS.filter(L => txt(q[L])).map(L => ({ id: L, texto: txt(q[L]) }));
        const certa = txt(q.correta).toLowerCase().replace(/[^a-e]/g, '').slice(0, 1);
        if (certa) resp.perguntas[pid] = { corretaId: certa, ...(txt(q.explicacao) ? { explicacao: txt(q.explicacao) } : {}) };
        return { id: pid, enunciado: txt(q.enunciado), alternativas };
      });
      if (typeId === 'cadeado_grupo') {
        config.regra = txt(l.cadeado_regra) || 'acertos';
        config.distribuicao = txt(l.cadeado_distribuicao) || 'diferente';
        if (config.regra === 'acertos') config.minAcertos = num(l.cadeado_min_acertos) ?? 0;
        else { config.fragmentos = fragmentosDoTexto(txt(l.cadeado_fragmentos)); resp.codigo = txt(l.cadeado_codigo); }
        config.espera = num(l.cadeado_espera) ?? 30;
        if (txt(l.cadeado_mensagem)) config.mensagem = txt(l.cadeado_mensagem);
      } else {
        config.aoErrar = txt(l.quiz_ao_errar) || 'repassar';
        config.segundos = num(l.quiz_segundos) ?? 60;
        config.mostrarNoTelao = sim(l.quiz_pergunta_no_telao);
        config.mostrarResposta = !/^(nao|não|n|false|0)$/i.test(txt(l.quiz_mostrar_resposta) || 'sim');
      }
      if (txt(l.explicacao)) resp.explicacao = txt(l.explicacao);
      respostas[id] = resp;
    } else if (typeId === 'cartoes_arrastar') {
      config.formato = txt(l.cartoes_formato) || 'ordenar';
      if (txt(l.enunciado)) config.enunciado = txt(l.enunciado);
      const linhasC = (tab.cartoes || []).filter(x => txt(x.etapa) === id);
      config.cartoes = linhasC.map((x, k) => ({ id: txt(x.id) || 'c' + (k + 1), texto: txt(x.texto) }));
      const resp = {};
      if (config.formato === 'ordenar') {
        const comOrdem = linhasC.map((x, k) => ({ id: config.cartoes[k].id, n: num(x.ordem_certa), k }));
        resp.ordem = comOrdem.sort((x, y) => ((x.n ?? 1e9) - (y.n ?? 1e9)) || (x.k - y.k)).map(x => x.id);
        config.conferencia = txt(l.cartoes_conferencia) || 'posicao';
      } else if (config.formato === 'classificar') {
        config.colunas = (tab.colunas || []).filter(x => txt(x.etapa) === id).map((x, k) => ({ id: txt(x.id) || 'k' + (k + 1), titulo: txt(x.titulo) }));
        resp.colunaDe = {};
        linhasC.forEach((x, k) => { if (txt(x.coluna_certa)) resp.colunaDe[config.cartoes[k].id] = txt(x.coluna_certa); });
      } else {
        config.polos = { esquerda: txt(l.cartoes_polo_esquerda), direita: txt(l.cartoes_polo_direita) };
        resp.posicao = {};
        linhasC.forEach((x, k) => { const v = num(x.posicao_certa); if (v !== undefined) resp.posicao[config.cartoes[k].id] = v; });
        resp.margem = num(l.cartoes_margem) ?? 15;
      }
      config.distribuicao = txt(l.cartoes_distribuicao) || 'todos';
      config.tentativas = txt(l.cartoes_tentativas) || 'uma';
      config.espera = num(l.cartoes_espera) ?? 30;
      config.revelarAoEncerrar = !/^(nao|não|n|false|0)$/i.test(txt(l.cartoes_revelar) || 'sim');
      if (txt(l.explicacao)) resp.explicacao = txt(l.explicacao);
      respostas[id] = resp;
    } else if (typeId === 'questao_individual') {
      config.enunciado = txt(l.enunciado);
      config.alternativas = ops.map(({ id, texto }) => ({ id, texto }));
    }
    const correta = ops.find(o => o.correta);
    if (correta) respostas[id] = { corretaId: correta.id, explicacao: txt(l.explicacao) };
    const padrao = tipo?.participacao || { organizacao: ['grupos'], envio: ['representante'], competicao: ['meta'] };
    return {
      id, ordem: l.ordem ?? i + 1, titulo: txt(l.titulo), typeId, typeVersion: tipo?.typeVersion || '1.0.0',
      ...(num(l.tempo_min) ? { tempoMin: num(l.tempo_min) } : {}),
      instrucao: txt(l.instrucao),
      participacao: {
        organizacao: txt(l.organizacao) || padrao.organizacao[0],
        envio: txt(l.envio) || padrao.envio[0],
        competicao: txt(l.competicao) || (padrao.competicao.includes('meta') ? 'meta' : padrao.competicao[0])
      },
      config
    };
  });

  const conexoes = etapasL.filter(l => txt(l.recebe_de)).map(l => {
    const de = etapas.find(e => e.id === txt(l.recebe_de)), para = etapas.find(e => e.id === txt(l.id));
    const portaDe = TIPOS[de?.typeId]?.producedOutputs?.[0]?.portId || 'hipotese_grupo';
    const portaPara = TIPOS[para?.typeId]?.acceptedInputs?.[0]?.portId || 'hipoteses_recebidas';
    return { id: `c_${txt(l.recebe_de)}_${txt(l.id)}`.slice(0, 64), de: { etapaId: txt(l.recebe_de), portId: portaDe }, para: { etapaId: txt(l.id), portId: portaPara }, agregacao: 'colecao_uma_por_grupo_planejado' };
  });

  const limiar = num(g.meta_limiar);
  const atividade = {
    schemaVersion: SCHEMA_VERSION,
    id: g.id || 'atividade', titulo: g.titulo || '', publico: g.publico || '',
    duracaoMin: num(g.duracao_min) ?? 50, regime: g.regime || 'fiel',
    perguntaCentral: g.pergunta_central || '', objetivos: g.objetivos || [], introducao: g.introducao || '',
    fontes: (tab.fontes || []).map(l => ({ id: txt(l.id), descricao: txt(l.descricao), localizacao: txt(l.localizacao), trecho: txt(l.trecho) })),
    grupos: (tab.grupos || []).map((l, i) => ({ id: txt(l.id), nome: txt(l.nome), ordemAlocacao: num(l.ordem) ?? i + 1, ...(txt(l.funcao) ? { funcao: txt(l.funcao) } : {}) })),
    etapas,
    pecas: (tab.pecas || []).map(l => {
      const natureza = txt(l.natureza) || 'sintetico';
      return { id: txt(l.id), etapaId: txt(l.etapa), destinatarios: txt(l.grupos).split(/[;,]/).map(x => x.trim()).filter(Boolean), origem: natureza === 'sintetico' && !txt(l.fonte) ? { natureza } : { natureza, fonteId: txt(l.fonte) }, conteudo: txt(l.conteudo) };
    }),
    conexoes,
    meta: { ativa: !/^(nao|não|n|false|0)$/i.test(g.meta_ativa || 'sim'), descricao: g.meta_descricao || '', etapas: g.meta_etapas || [], limiar: limiar === undefined ? 0.5 : (limiar > 1 ? limiar / 100 : limiar) },
    docente: { respostas, guia: g.guia || [], pontosDeDiscussao: g.pontos_de_discussao || [] },
    pendencias: g.pendencias || []
  };
  return { atividade, problemas };
}
