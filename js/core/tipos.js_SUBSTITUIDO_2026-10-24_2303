  cartoes_arrastar: {
    typeId: 'cartoes_arrastar',
    typeVersion: '1.0.0',
    nome: 'Cartões de arrastar',
    descricao: 'O grupo arrasta cartões num quadro compartilhado: põe em sequência (ordenar), separa em colunas (classificar) ou posiciona cada caso numa linha entre dois polos (termômetro). Cada celular pode segurar só alguns cartões, e o líder confirma o quadro.',
    configuracao: {
      formato: "'ordenar' | 'classificar' | 'termometro'",
      enunciado: 'texto opcional: o comando para o grupo (ex.: "Ponha a cascata na ordem")',
      cartoes: 'lista (2 a 20) de {id, texto}; no formato ordenar, a ordem certa fica em docente.respostas[etapa].ordem (lista de ids)',
      colunas: "formato 'classificar': lista (2 a 6) de {id, titulo}; a coluna certa de cada cartão fica em docente.respostas[etapa].colunaDe {cartaoId: colunaId}",
      polos: "formato 'termometro': {esquerda, direita} (ex.: 'Totalmente antiético' / 'Totalmente ético'); a posição esperada (0 a 100, opcional) fica em docente.respostas[etapa].posicao {cartaoId: n}, com margem (padrão 15). Sem posições, a etapa é só para debate",
      distribuicao: "'todos' (qualquer um do grupo move qualquer cartão) | 'fracionado' (cada celular segura alguns cartões e só ele os move)",
      tentativas: "'uma' (o primeiro envio vale) | 'repetir' (errou: espera e tenta de novo)",
      espera: "segundos de espera depois de um envio errado, em 'repetir' (padrão 30)",
      conferencia: "formato 'ordenar': 'posicao' (cartões no lugar exato, padrão) | 'vizinhos' (pares vizinhos na ordem certa)",
      revelarAoEncerrar: 'booleano (padrão true): ao encerrar, o telão mostra a resposta esperada (e, no termômetro, onde cada grupo pôs cada caso)'
    },
    acceptedInputs: [],
    producedOutputs: [],
    participacao: { organizacao: ['grupos', 'representantes'], envio: ['representante'], competicao: ['desligada', 'meta', 'entre_grupos'] },
    completionPolicy: 'envio_confirmado',
    assessmentPolicy: 'gabarito_docente',
    contingencyPolicy: ['aguardar'],
    usaPecas: false,
    validar(etapa) {
      const d = [], c = etapa.config || {};
      if (!['ordenar', 'classificar', 'termometro'].includes(c.formato)) d.push(erro('config.formato', "Escolha o formato: 'ordenar', 'classificar' ou 'termometro'."));
      if (c.enunciado !== undefined && c.enunciado !== '' && !texto(c.enunciado, 500)) d.push(erro('config.enunciado', 'Comando longo demais (até 500 caracteres).'));
      const cs = c.cartoes;
      if (!Array.isArray(cs) || cs.length < 2 || cs.length > 20) d.push(erro('config.cartoes', 'Informe de 2 a 20 cartões.'));
      else {
        const ids = cs.map(x => x.id);
        if (new Set(ids).size !== ids.length || ids.some(x => !/^[a-z0-9][a-z0-9_-]{0,31}$/.test(String(x)))) d.push(erro('config.cartoes', 'IDs de cartão ausentes ou repetidos.'));
        cs.forEach((x, i) => { if (!texto(x.texto, 200)) d.push(erro(`config.cartoes[${i}]`, `Cartão ${i + 1} sem texto (ou com mais de 200 caracteres).`)); });
        const rep = cs.map(x => String(x.texto || '').trim().toLowerCase()).filter((t, i, l) => t && l.indexOf(t) !== i);
        if (rep.length && c.formato === 'ordenar') d.push(aviso('config.cartoes', 'Há cartões com o mesmo texto: a ordem entre eles fica ambígua.'));
      }
      if (c.formato === 'classificar') {
        const cols = c.colunas;
        if (!Array.isArray(cols) || cols.length < 2 || cols.length > 6) d.push(erro('config.colunas', 'Informe de 2 a 6 colunas.'));
        else {
          if (new Set(cols.map(x => x.id)).size !== cols.length || cols.some(x => !/^[a-z0-9][a-z0-9_-]{0,31}$/.test(String(x.id)))) d.push(erro('config.colunas', 'IDs de coluna ausentes ou repetidos.'));
          cols.forEach((x, i) => { if (!texto(x.titulo, 80)) d.push(erro(`config.colunas[${i}]`, `Coluna ${i + 1} sem título.`)); });
        }
      }
      if (c.formato === 'termometro' && (!texto(c.polos?.esquerda, 80) || !texto(c.polos?.direita, 80))) d.push(erro('config.polos', 'Escreva os dois polos da linha (esquerda e direita).'));
      if (!['todos', 'fracionado'].includes(c.distribuicao || 'todos')) d.push(erro('config.distribuicao', "Distribuição deve ser 'todos' ou 'fracionado'."));
      if (!['uma', 'repetir'].includes(c.tentativas || 'uma')) d.push(erro('config.tentativas', "Tentativas: 'uma' ou 'repetir'."));
      const esp = c.espera ?? 30;
      if (!(Number.isFinite(esp) && esp >= 0 && esp <= 600)) d.push(erro('config.espera', 'Espera deve ficar entre 0 e 600 segundos.'));
      if (c.formato === 'ordenar' && !['posicao', 'vizinhos'].includes(c.conferencia || 'posicao')) d.push(erro('config.conferencia', "Conferência: 'posicao' ou 'vizinhos'."));
      if (c.distribuicao === 'fracionado' && Array.isArray(cs) && cs.length < 3) d.push(aviso('config.distribuicao', 'Com tão poucos cartões, vários celulares ficarão sem cartão.'));
      if (c.modo !== undefined && !(c.modo === 'trechos' && c.formato === 'ordenar')) d.push(erro('config.modo', 'O modo por trechos é só para o formato ordenar.'));
      if (c.modo === 'trechos' && etapa.participacao?.organizacao !== 'grupos') d.push(erro('config.modo', 'O modo por trechos é em grupos (cada grupo recebe um trecho).'));
      return d;
    },
    validarRespostas(etapa, r) {
      const d = [], c = etapa.config || {}, ids = (c.cartoes || []).map(x => x.id), local = `docente.respostas.${etapa.id}`;
      if (c.formato === 'ordenar') {
        const o = r?.ordem;
        if (!Array.isArray(o) || o.length !== ids.length || new Set(o).size !== o.length || o.some(id => !ids.includes(id)))
          d.push(erro(`${local}.ordem`, `Defina a ordem certa de todos os cartões de "${etapa.titulo}".`));
      }
      if (c.formato === 'classificar') {
        const cols = new Set((c.colunas || []).map(x => x.id));
        const sem = (c.cartoes || []).filter(x => !cols.has(r?.colunaDe?.[x.id]));
        if (sem.length) d.push(erro(`${local}.colunaDe`, `Escolha a coluna certa de ${sem.length === 1 ? 'um cartão' : sem.length + ' cartões'} em "${etapa.titulo}" (ex.: “${String(sem[0].texto || sem[0].id).slice(0, 30)}”).`));
      }
      if (c.formato === 'termometro') {
        const pos = r?.posicao || {};
        for (const [id, v] of Object.entries(pos)) if (v !== null && v !== '' && !(ids.includes(id) && Number.isFinite(Number(v)) && v >= 0 && v <= 100)) d.push(erro(`${local}.posicao`, 'Posição esperada deve ficar entre 0 e 100.'));
        if (r?.margem !== undefined && !(Number.isFinite(Number(r.margem)) && r.margem >= 1 && r.margem <= 50)) d.push(erro(`${local}.margem`, 'A margem deve ficar entre 1 e 50.'));
      }
      return d;
    }
  },

