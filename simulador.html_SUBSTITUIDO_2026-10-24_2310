<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>MOSAICO · Simulador de aula</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800;900&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="icon" href="assets/favicon.png" type="image/png">
<link rel="apple-touch-icon" href="assets/apple-touch-icon.png">
<link rel="stylesheet" href="css/mosaico.css">
<style>
  body { overflow-x: hidden; }
  .sim-topo { position: sticky; top: 0; z-index: 5; background: rgba(11,15,23,.96); border-bottom: 1px solid var(--linha); padding: 10px 16px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .sim-topo input { width: 120px; min-height: 44px; }
  .sim-topo input[type=checkbox] { width: 22px; height: 22px; min-height: 0; }
  .sim-topo .btn { min-height: 44px; }
  .sim-palco { padding: 16px; display: grid; gap: 16px; }
  .sim-telao { width: 100%; max-width: 1500px; margin: 0 auto; aspect-ratio: 16 / 9; border: 2px solid var(--linha); border-radius: 12px; overflow: hidden; background: #000; }
  .sim-telao iframe { width: 1280px; height: 720px; border: 0; transform-origin: 0 0; }
  .sim-celulares { display: flex; flex-wrap: wrap; gap: 14px; }
  .sim-celular { width: calc(390px * var(--esc)); height: calc(760px * var(--esc)); border: 2px solid var(--linha); border-radius: 18px; overflow: hidden; background: var(--fundo); position: relative; }
  .sim-celular iframe { width: 390px; height: 760px; border: 0; transform: scale(var(--esc)); transform-origin: 0 0; }
  .sim-celular .rotulo { position: absolute; bottom: 4px; right: 8px; font-size: 11px; color: var(--texto-2); background: rgba(0,0,0,.6); padding: 1px 6px; border-radius: 6px; }
  :root { --esc: .62; }
</style>
</head>
<body>
<div class="sim-topo">
  <span class="marca"><img class="logo" src="assets/mosaico.webp" alt="" width="40" height="40">Simulador</span>
  <label for="codigo" style="margin:0">Sala</label><input id="codigo" inputmode="numeric" maxlength="6" placeholder="código">
  <label for="qtd" style="margin:0">Participantes</label><input id="qtd" type="number" min="1" max="30" value="12">
  <button class="btn primario" id="iniciar">Simular</button>
  <button class="btn" id="mais">+1</button>
  <label style="margin:0;display:flex;gap:6px;align-items:center"><input type="checkbox" id="autoTodos" checked> Piloto automático em todos</label>
  <label for="escala" style="margin:0">Tamanho</label>
  <select id="escala" style="width:auto;min-height:44px"><option value=".45">Pequeno</option><option value=".62" selected>Médio</option><option value=".8">Grande</option></select>
  <span class="sutil" id="info">Abra a sala no celular, digite o código aqui e clique em Simular.</span>
</div>
<div class="sim-palco">
  <div class="sim-telao" id="telao" hidden></div>
  <div class="sim-celulares" id="celulares"></div>
</div>
<script type="module" src="js/simulador.js"></script>
</body>
</html>
