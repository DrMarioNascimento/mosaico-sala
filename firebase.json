{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "tests/**",
      "package.json",
      "README.md",
      "**/*_SUBSTITUIDO_*",
      "firebase-debug*.log",
      "**/*.test.mjs",
      "ERGONOMIA-DOCENTE.md",
      "OPERACAO-SALAS.md",
      "AUDITORIA-FIREBASE-2026-10-25.json"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "cleanUrls": true
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "singleProjectMode": true
  }
}
