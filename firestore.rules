rules_version = '2';
// MOSAICO · Sala — regras do Firestore (projeto mosaico-sala, plano gratuito)
// O material docente (respostas esperadas, guia) NUNCA vem para o servidor:
// fica só no aparelho de quem conduz. Aqui ficam o estado público da sala,
// os pacotes de cada grupo e os envios.
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function google() {
      return signed() && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }
    // Administradores: e-mails fixos (os mesmos de ADMINS em js/mestres.js). Só eles editam a lista de mestres.
    function fixos() { return ['mariocnascimento@gmail.com', 'ramonmelo.com@gmail.com']; }
    function admin() { return google() && request.auth.token.email in fixos(); }
    // Lista de mestres: os e-mails fixos + o documento config/mestres {emails: [...]}.
    function mestre() {
      return google() && (
        request.auth.token.email in fixos() ||
        (exists(/databases/$(database)/documents/config/mestres) &&
         request.auth.token.email in get(/databases/$(database)/documents/config/mestres).data.emails));
    }
    function sala(c) { return get(/databases/$(database)/documents/rooms/$(c)).data; }
    // Prazo (TTL) opcional, mas, se vier, é o da sala: ninguém escapa da limpeza com um prazo inventado.
    function prazoDaSala(c, d) { return !('expiresAt' in d) || d.expiresAt == sala(c).expiresAt; }
    function dono(c) { return signed() && sala(c).owner == request.auth.uid; }

    // Configurações administrativas não são públicas para logins anônimos.
    match /config/{d} { allow read, write: if false; }
    // A lista de mestres é editada na tela de Planejamento, só pelos administradores.
    match /config/mestres {
      allow read: if admin();
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['emails'])
        && request.resource.data.emails is list && request.resource.data.emails.size() <= 200;
      allow delete: if false;
    }

    // Manual do professor: o texto fica aqui (e não no site público, nem no repositório).
    // Só quem está na lista de mestres lê; só os administradores publicam uma nova versão.
    match /manual/{d} {
      allow read: if mestre();
      allow create, update: if admin() && d == 'atual'
        && request.resource.data.keys().hasOnly(['html', 'versao', 'autor', 'atualizadoEm'])
        && request.resource.data.html is string && request.resource.data.html.size() > 0 && request.resource.data.html.size() < 900000
        && request.resource.data.versao is string && request.resource.data.versao.size() <= 80
        && request.resource.data.autor is string && request.resource.data.autor.size() <= 200
        && request.resource.data.atualizadoEm == request.time;
      allow delete: if false;
    }

    // Biblioteca de atividades: FECHADA. Só contas da lista de mestres; cada uma lê e edita as suas,
    // e lê as que outro mestre marcou como compartilhadas. Nenhum dado de participante fica aqui.
    match /biblioteca/{id} {
      // Administração: os administradores fixos leem e apagam qualquer atividade (sem editar a de outra pessoa).
      allow read: if admin() || (mestre() && (resource.data.owner == request.auth.uid || resource.data.compartilhada == true));
      allow create: if mestre() && bibliotecaValida(request.resource.data) && request.resource.data.owner == request.auth.uid;
      allow update: if mestre() && resource.data.owner == request.auth.uid && bibliotecaValida(request.resource.data)
        && request.resource.data.owner == resource.data.owner;
      allow delete: if admin() || (mestre() && resource.data.owner == request.auth.uid);
    }
    function bibliotecaValida(d) {
      return d.keys().hasOnly(['owner', 'autor', 'titulo', 'conteudo', 'compartilhada', 'atualizadoEm'])
        && d.titulo is string && d.titulo.size() <= 200
        && d.conteudo is string && d.conteudo.size() < 900000
        && d.compartilhada is bool && d.atualizadoEm == request.time;
    }

    match /rooms/{c} {
      allow get: if signed();
      // Administração vê todas; o professor lista só as próprias (faxina das vencidas abertas em outro aparelho).
      allow list: if admin() || (mestre() && resource.data.owner == request.auth.uid);
      allow create: if mestre() && c.matches('[0-9]{6}')
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h');
      allow update: if signed() && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt;
      allow delete: if admin() || (signed() && resource.data.owner == request.auth.uid);

      // Encerrar pela administração apaga a sala inteira: membros, pacotes e envios.
      match /members/{uid} {
        allow get: if signed() && (request.auth.uid == uid || dono(c));
        allow list: if dono(c) || admin();
        allow create: if signed() && uid == request.auth.uid
          && sala(c).status == 'open' && sala(c).entradaAberta == true
          && request.resource.data.keys().hasOnly(['nome', 'entrouEm', 'expiresAt'])
          && prazoDaSala(c, request.resource.data)
          && request.resource.data.nome is string
          && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 30;
        allow delete: if dono(c) || admin();
      }

      // Cada grupo só lê o próprio pacote (ou o de um grupo que esteja cobrindo por contingência).
      match /pacotes/{g} {
        allow read: if signed() && (
          dono(c) ||
          g == request.auth.uid ||                                   // peça da montagem, só deste celular
          (g == 'revelacao' && sala(c).revelacao != null) ||          // todo montado, revelado por quem conduz
          (g == 'individual' && request.auth.uid in sala(c).nomes) ||
          request.auth.uid in sala(c).composicao.get(g, []) ||
          request.auth.uid in sala(c).leitoresExtra.get(g, []));
        allow write: if dono(c);
        allow list, delete: if admin();
      }

      match /envios/{id} {
        allow get: if signed() && (dono(c) || resource == null || resource.data.autor == request.auth.uid);
        allow list: if dono(c) || admin();
        allow create: if signed() && envioValido(c, id, request.resource.data);
        allow delete: if dono(c) || admin();
        // Sem update: um envio confirmado nunca é sobrescrito.
      }

      function envioValido(c, id, d) {
        let s = sala(c);
        return d.keys().hasOnly(['etapaId', 'escopo', 'grupoId', 'autor', 'dados', 'contingencia', 'enviadoEm', 'expiresAt'])
          && prazoDaSala(c, d)
          && d.autor == request.auth.uid && d.dados is map && d.enviadoEm == request.time
          && (
            // Contingência registrada por quem conduz (ex.: grupo vazio)
            s.owner == request.auth.uid ||
            (s.fase == 'etapa' && d.etapaId == s.etapaAtual && (
              (d.escopo == 'grupo' && id == d.etapaId + '__' + d.grupoId &&
                (s.representantes.get(d.grupoId, '') == request.auth.uid ||
                 s.executores.get(d.grupoId, '') == request.auth.uid)) ||
              (d.escopo == 'participante' && id == d.etapaId + '__' + request.auth.uid &&
                request.auth.uid in s.nomes) ||
              // Cadeado do grupo e quiz: várias tentativas, cada uma um documento novo
              // (etapa__quem__t1, t2… · etapa__grupo__c1… · etapa__grupo__r1…). Quem avalia é quem conduz.
              (d.escopo == 'tentativa' && tentativaValida(s, id, d))
            ))
          );
      }
      function tentativaValida(s, id, d) {
        let p = id.split('__');
        return p.size() == 3 && p[0] == d.etapaId && p[2].matches('[a-z][0-9]{1,4}') && (
          (p[1] == request.auth.uid && request.auth.uid in s.nomes) ||
          (p[1] == d.grupoId && (s.representantes.get(d.grupoId, '') == request.auth.uid ||
                                 s.executores.get(d.grupoId, '') == request.auth.uid)));
      }
    }
  }
}
